# Демо-конфигурация Clinical Compass (НЕ для прода).
# Скопируйте в .env для запуска демо-стека:  cp .env.example .env
# Для продакшна используйте tools/gen-secrets.sh (генерирует случайные секреты
# и выставляет CC_ALLOW_DEMO_SECRETS=false).

# NEW-5: демо-флаг обязателен — без него приложение падает на демо-секретах (fail-fast).
CC_ALLOW_DEMO_SECRETS=true

# Демо-секреты (известны, НЕ для прода).
POSTGRES_PASSWORD=compass
CC_JWT_SECRET=demo-jwt-secret-0123456789abcdefghij
CC_DATA_KEY=compass-demo-data-key-do-not-use-in-prod-0123456789

# Демо работает по HTTP (nginx без TLS) → Secure-cookie выключен.
# Прод за HTTPS: CC_COOKIE_SECURE=true.
CC_COOKIE_SECURE=false
# NER-детекция ФИО для деперсонализации (docs/12): опционально,
# требует pip install -e "api[ner]" (natasha). false — regex/deny-list.
CC_DEPERSONALIZE_NER=false

# 2FA: false отключает проверку TOTP при входе CLINICIAN/ADMIN
# (totp_secret всё равно хранится в БД — включить обратно одним флагом).
# Прод (CC_PROD_MODE=true) требует true.
CC_REQUIRE_OTP=true

# LLM-роутер раздела БЗ для ассистента врача (docs/04 FR-17).
# OpenAI-совместимый /v1 (llama-server/vLLM/Ollama); пусто → поиск по всем разделам.
# Демо: tools/llm.sh поднимает llama.cpp на хосте → http://host.docker.internal:18080/v1
# Прод/локально: omniroute (OpenAI-совместимый шлюз с ключом). Модель — id из
# /v1/models шлюза (например opencode-go/deepseek-v4.1-flash) или имя комбо.
# Комбо home-stable в omniroute сам идёт free-first: сначала бесплатные
# opencode/openrouter-дорожки, затем auto/best-free, платные — в самом конце.
# Контейнер не видит loopback хоста, поэтому шлюз публикуется на docker-шлюз
# (172.17.0.1) через relay-контейнер; ключ — персональный API key omniroute.
CC_ASSISTANT_LLM_URL=
CC_ASSISTANT_LLM_MODEL=local
CC_ASSISTANT_LLM_TIMEOUT=10
# Таймаут генерации ответа по найденным сниппетам, сек (FR-17). Больше роутера:
# модель пишет связный текст. Таймаут/сбой → детерминированный build_rag_answer.
CC_ASSISTANT_LLM_ANSWER_TIMEOUT=25
# CC_ASSISTANT_LLM_API_KEY: Bearer для шлюза с аутентификацией (omniroute).
# Пусто → заголовок Authorization не отправляется (llama-server без ключа).
CC_ASSISTANT_LLM_API_KEY=
# Потолок одновременных прогонов RAG-агента на процесс API: у агента свой
# лимитер AnyIO, а не общий пул (40 потоков). Всплеск запросов ассистента ждёт
# здесь, пул остаётся push/эмбеддингам/Qdrant других ручек (docs/03 §12).
CC_ASSISTANT_THREAD_LIMIT=8
# Дедлайн на весь прогон агента (ожидание лимитера + retrieval + LLM), сек.
# По истечении — 503 ASSISTANT_TIMEOUT с Retry-After: 5, ответ в тред не пишется.
CC_ASSISTANT_DEADLINE_S=60
CC_CHAT_INSIGHTS_ENABLED=false
# FR-37: анамнез пациента (хранение + черновик LLM). Черновику нужен LLM URL выше.
CC_ANAMNESIS_ENABLED=false

# docs/18 §4.3 (FR-39, PR P3): ИИ-ассистент сессии врача — аудио, расшифровка,
# черновик протокола. По умолчанию ВЫКЛЮЧЕН: календарь, ручной протокол и подпись
# работают без него. Черновику дополнительно нужен CC_ASSISTANT_LLM_URL выше,
# расшифровке — CC_ML_URL ниже (сайдкар, профиль gpu).
CC_SESSION_AI_ENABLED=false
# Потолок аудио на сессию, МБ (413 AUDIO_TOO_LARGE).
CC_SESSION_AUDIO_MAX_MB=200
# Сек на один шаг ИИ-конвейера: /v1/transcribe сайдкара и черновик протокола в LLM.
CC_SESSION_AI_TIMEOUT=600

# Локальная модель в контуре (docs/17; инфраструктура — docker-compose.local-llm.yml).
# llama.cpp server в сети infra_default, api видит его как http://local-llm:8080/v1,
# трафик не покидает хост (152-ФЗ, docs/10). GGUF кладётся в infra/models/ (gitignore);
# MODEL_PATH — путь внутри /models. CPU по умолчанию (до ~8B Q4 рабочие), GPU:
# CC_LOCAL_LLM_N_GPU_LAYERS=99 + раскомментировать `gpus: all` в оверлее.
# CC_LOCAL_LLM_MODELS_DIR=./models
# CC_LOCAL_LLM_MODEL_PATH=model.gguf
CC_LOCAL_LLM_CTX=8192
CC_LOCAL_LLM_N_GPU_LAYERS=0
# Порт публикуется только на 127.0.0.1 — для curl с хоста.
# CC_LOCAL_LLM_PORT=8080
#
# Переключение ассистента на локальную модель (прод-дефолт — пустой URL, т.е. выкл.):
#   CC_ASSISTANT_LLM_URL=http://local-llm:8080/v1
#   CC_ASSISTANT_LLM_MODEL=local   # = --alias оверлея; иначе 404 model not found
#   CC_ASSISTANT_LLM_API_KEY=      # llama-server без ключа
# затем: docker compose -f docker-compose.yml up -d api

# Web Push VAPID: base64(PKCS8 PEM, EC P-256). Дефолт в compose — демо-ключ,
# общий для api и reminders-worker (anchor x-vapid). Своя пара:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# Смена ключа инвалидирует существующие подписки браузеров — они переподпишутся.
# CC_VAPID_PRIVATE_KEY=

# ── БД: пулы и процессы (README, раздел про производительность) ─────────────
# Бюджет: WEB_CONCURRENCY × (POOL+OVERFLOW+2) + BACKGROUND × (BG_POOL+BG_OVERFLOW+2)
# не должен превышать CC_DB_MAX_CONNECTIONS (max_connections Postgres).
WEB_CONCURRENCY=1
CC_DB_POOL_SIZE=20
CC_DB_MAX_OVERFLOW=20
CC_DB_POOL_TIMEOUT=30
CC_DB_MAX_CONNECTIONS=100
# Фоновые сервисы: reminders-worker и kb-enrichment держат маленький пул.
CC_DB_BG_POOL_SIZE=2
CC_DB_BG_MAX_OVERFLOW=1
CC_DB_BACKGROUND_PROCESSES=2
# Лимит неудачных входов на IP за окно (любые email), помимо пары (IP, email).
CC_RATE_IP_MAX=30

# ── Rate limiter логинов (docs/03 §12, docs/10 R24) ────────────────────────
# Общий счётчик неудачных попыток входа: redis://redis:6379/0 (сервис redis
# в docker-compose) → все воркеры uvicorn и реплики api тратят ОДИН бюджет
# CC_RATE_MAX. В compose URL подставляется по умолчанию; выключить общий
# счётчик (memory: бюджет на процесс, рестарт обнуляет окно) —
# CC_RATE_BACKEND=memory. Вне compose пустой CC_REDIS_URL тоже даёт memory.
CC_REDIS_URL=redis://redis:6379/0
# auto | memory | redis. auto — Redis при заданном и доступном CC_REDIS_URL,
# иначе memory с WARNING в лог (без extra api[redis] — тоже memory).
CC_RATE_BACKEND=auto
# Сек на socket/connect Redis: мёртвый Redis не задерживает логин, limiter
# деградирует в memory (fail-open по общему бюджету).
CC_RATE_REDIS_TIMEOUT=0.3

# ── Эмбеддер KB (docs/07 §5, docs/08 §4) ───────────────────────────────────
# hash — демо/тесты (dense+sparse, без внешних весов); bge-m3 — прод-качество,
# требует extra "api[ru]" (torch) и полной переиндексации коллекции.
CC_EMBEDDER=hash
CC_EMBEDDER_MODEL=BAAI/bge-m3
CC_EMBEDDER_DEVICE=auto
CC_EMBEDDER_BATCH_SIZE=8
# dense-гейт «в KB нет ответа» для bge-m3 (косинус, см. services/agent.py).
CC_KB_MIN_SCORE=0.45
# TTL кеша собранного корпуса build_corpus(), сек; 0 — кеш выключен.
CC_KB_CORPUS_TTL_SECONDS=60

# ── ML-сайдкар на GPU (docs/08 §4.1, docs/12) ──────────────────────────────
# Порядок запуска на GPU-хосте:
#   1) docker compose --profile gpu run --rm ml-warmup   # разово, качает веса
#   2) docker compose --profile gpu up -d ml             # дальше только офлайн
# ml ходит только во внутренней сети mlnet (без egress) и не видит БД/очереди.
# Без профиля gpu сайдкара нет: на не-GPU хосте оставьте CC_ML_URL пустым,
# CC_EMBEDDER=hash и CC_DEPERSONALIZE_NER=off — api работает как раньше.
#
# Внутренний адрес сервиса ml (порт на хост не публикуется).
CC_ML_URL=http://ml:8080
# Общий секрет api ↔ ml (заголовок X-CC-ML-Token). ОБЯЗАТЕЛЕН: без него
# сайдкар не стартует (fail-closed). В проде генерируется tools/gen-secrets.sh;
# для локальной отладки можно CC_ML_ALLOW_ANONYMOUS=1 (никогда не прод).
CC_ML_TOKEN=
CC_ML_ALLOW_ANONYMOUS=0
# Сек на один вызов сайдкара; маскирование ПДн ждёт этот таймаут (docs/12).
# Первый вызов после старта ml грузит веса (~10 с), поэтому ставим с запасом.
CC_ML_TIMEOUT=30
#
# --- Параметры самого сервиса ml (читаются контейнерами ml/ml-warmup) ---
# auto | cuda | cpu. auto — CUDA при доступной видеокарте.
CC_ML_DEVICE=cuda
# Профиль эмбеддингов по умолчанию: qwen3-0.6b | e5-large-instruct | bge-m3.
# Профиль меняется без правки кода (эта переменная читается сайдкаром).
CC_ML_DEFAULT_PROFILE=qwen3-0.6b
# Дополнительные/переопределённые профили: JSON {имя: {model, dense_size,
# query_prefix, passage_prefix}}. Пусто — встроенная таблица ml/models.py.
CC_ML_PROFILES=
# Модели реранка и NER (обязаны совпадать у ml-warmup и ml).
CC_ML_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CC_ML_NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
#
# Транскрипция аудио сессии (POST /v1/transcribe). По умолчанию выключена:
# 1 — включить (тогда ml-warmup дополнительно качает ~1.6 ГБ весов Whisper).
CC_ML_ASR=0
# CT2-веса faster-whisper (обязаны совпадать у ml-warmup и ml).
CC_ML_ASR_MODEL=dropbox-dash/faster-whisper-large-v3-turbo
# cuda | cpu — ASR можно увести на CPU отдельно от остальных моделей.
CC_ML_ASR_DEVICE=cuda
# Тип вычислений CTranslate2: int8_float16 (CUDA) | int8 (CPU) | float16.
CC_ML_ASR_COMPUTE=int8_float16
# Потолок аудио в МБ (больше — 413 payload_too_large).
CC_ML_ASR_MAX_MB=200
# Одновременных распознаваний (1..4); остальные запросы — 503 busy.
CC_ML_ASR_CONCURRENCY=1
#
# Веса лежат в docker-томе ml-models (HF_HOME=/models). ml-warmup скачивает
# их (~4 ГБ, разовый egress), после чего ml стартует с HF_HUB_OFFLINE=1 и
# интернет ему не нужен; пустой том при offline-старте — ошибка загрузки.
