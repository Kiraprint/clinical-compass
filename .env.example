# Демо-конфигурация Clinical Compass (НЕ для прода).
# Скопируйте в .env для запуска демо-стека:  cp .env.example .env
# Для продакшна используйте tools/gen-secrets.sh (генерирует случайные секреты
# и выставляет CC_ALLOW_DEMO_SECRETS=false).

# NEW-5: демо-флаг обязателен — без него приложение падает на демо-секретах (fail-fast).
CC_ALLOW_DEMO_SECRETS=true

# Демо-секреты (известны, НЕ для прода).
POSTGRES_PASSWORD=compass
CC_JWT_SECRET=demo-jwt-secret-0123456789abcdefghij
CC_DATA_KEY=compass-demo-data-key-do-not-use-in-prod-0123456789

# Демо работает по HTTP (nginx без TLS) → Secure-cookie выключен.
# Прод за HTTPS: CC_COOKIE_SECURE=true.
CC_COOKIE_SECURE=false

# Обогащение КБ (docs/15): PubMed + ВОЗ. Email/ключ NCBI желательны (3 req/s без ключа).
CC_ENRICH_PUBMED_EMAIL=
CC_ENRICH_PUBMED_API_KEY=
CC_ENRICH_PUBMED_DAYS=30
CC_ENRICH_INTERVAL_HOURS=24

# FR-25: интеграция с ЕМИАС. Egress выключен по умолчанию (docs/10 R17-R19).
# Демо с локальным моком:
#   docker compose -f infra/docker-compose.yml --profile emias up -d emias-mock
#   CC_EMIAS_ENABLED=true CC_EMIAS_BASE_URL=http://emias-mock:8090 CC_EMIAS_ALLOW_INSECURE=true
CC_EMIAS_ENABLED=false
CC_EMIAS_BASE_URL=http://emias-mock:8090
CC_EMIAS_CLIENT_ID=compass
CC_EMIAS_CLIENT_SECRET=compass-secret
# http допустим ТОЛЬКО для мока; прод ЕМИАС — https (mTLS/ГОСТ-TLS на периметре).
CC_EMIAS_ALLOW_INSECURE=false
CC_EMIAS_TIMEOUT=10
CC_EMIAS_MAX_ATTEMPTS=3
CC_EMIAS_MAX_RESPONSE_BYTES=4194304
# Перец для sha256(СНИЛС). Пусто → CC_DATA_KEY. Прод — отдельный секрет из KMS.
CC_EMIAS_SNILS_PEPPER=
# Параметры мока (сервис emias-mock).
CC_EMIAS_MOCK_LATENCY_MS=0
CC_EMIAS_MOCK_TIMEOUT_S=2
CC_EMIAS_MOCK_RATE_LIMIT=60
