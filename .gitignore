# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
dist/
build/

# Node/UI
node_modules/
ui/dist/
e2e/playwright-report/
e2e/test-results/

# Bench (эмбеддеры): venv и производные данные бенчмарка в git не тащим
bench/.venv/
bench/data/
bench/sources/
bench/ner/data/
bench/__pycache__/

# Env / secrets
.env
*.env

# DB
*.sqlite

# Кейс чемпионата — конфиденциальные материалы (регламент §13, 5 лет).
# Текст кейса не коммитится в репозиторий. Шаблон *.pdf — кодировко-независимый
# (имя файла в NFD с combining-символами, паттерн «Кейс_*.pdf» не совпадал).
/*.pdf
/*.docx
# Полные тексты клинических рекомендаций (копирайт) — в кеш, не в git (docs/08 §2).
api/app/data/guidelines_cache/

# Demo tunnel (Cloudflare quick tunnel + ngrok стабильный)
tools/bin/
tools/.tunnel.pid
tools/.tunnel.log
tools/.tunnel.url
tools/.ngrok.pid
tools/.ngrok.log
tools/.ngrok.url
tools/.xtunnel.pid
tools/.xtunnel.log
tools/.xtunnel.url
# Реальный ngrok-конфиг может содержать authtoken — не коммитим; пример в *.example
tools/ngrok.yml
# Токен fxTunnel — не коммитим (см. tools/.fxtun.env.example)
tools/.fxtun.pid
tools/.fxtun.log
tools/.fxtun.url
tools/.fxtun.env
# Клиентский бинарник fxTunnel (~20МБ) — собирается в Docker-образ, не в git
tools/fxtun-docker/fxtunnel

# Android (item 4): Firebase-конфиг приложения приходит из CI-секрета
mobile/android/app/google-services.json
mobile/android/.gradle
mobile/android/app/release.keystore
mobile/android/keystore.properties
*.apk
/test-results/
e2e/test-results/
tools/backups/
infra/.env
